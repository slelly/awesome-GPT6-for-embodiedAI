    "github": {"enabled": true, "allowlist": ["api.github.com", "github.com"], "denylist": [], "deny_terms": [], "languages": ["en", "zh"]},
    "feed": {"enabled": true, "allowlist": [], "denylist": [], "deny_terms": [], "languages": ["en", "zh"]}
